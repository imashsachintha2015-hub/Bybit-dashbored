# MASIS V3 — credentials and tuning. Copy to .env and fill in, or export directly.
#
# IMPORTANT: the previous version of server.py had live keys hard-coded as
# string literals in the source file. Treat every one of those keys as
# compromised and rotate it before using this system:
#   - Bybit:     API Management -> delete the old key, create a new one
#   - DeepSeek:  revoke the old API key and issue a new one
#   - Benzinga / CoinGecko: rotate likewise
# Never commit the filled-in .env.

# ── Required ──
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Demo endpoint by default. Point at https://api.bybit.com only when you
# intend to trade real money.
BYBIT_BASE_URL=https://api-demo.bybit.com

# ── Optional: DeepSeek (the system runs fully without it) ──
# OFF by default. Nothing is sent to DeepSeek unless DEEPSEEK_ENABLED=1, and a DEEPSEEK_API_KEY that is
# left in .env or in the host's variables (Railway) is ignored while it is off. The news score falls back to
# keywords, the market read to the local quant read, the chart read to WAIT.
# Check it on a running server: GET /api/llm/status -> "enabled": false
DEEPSEEK_ENABLED=0
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Hard daily ceiling on model calls. The old build had no ceiling and made
# roughly 2,400 calls a day, nearly all of them duplicates of a state that had
# not changed. 120 is generous for the gated policy in agents/deepseek-governor.js.
DEEPSEEK_DAILY_CALL_BUDGET=120

# ── Optional: news and macro context ──
BENZINGA_API_KEY=
COINGECKO_API_KEY=
NEWS_CACHE_TTL=300
MARKET_OVERVIEW_TTL=300

# ── Unified Supabase Cloud Database (Primary for Vercel & Daemons) ──
SUPABASE_URL=https://rzizfjujdlmevywutjvv.supabase.co
SUPABASE_ANON_KEY=

# ── Only needed when deploying api/ to Vercel as serverless functions ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Strategy runner (daemons/masis_runner.py, see RUNNER.md) ──
# The runner places demo orders for the 4h trend strategy and paper-trades the snap-back.
# It refuses a non-demo BYBIT_BASE_URL unless MASIS_ALLOW_REAL_MONEY=1.
MASIS_RUNNER=1
# 1 = simulate everything, place no orders
MASIS_PAPER=0
# record-only research daemon (daemons/forward_lab.py)
MASIS_FORWARD_LAB=1
MASIS_LEGACY_ENGINE=0
RUNNER_SNAP_LIVE=0
RUNNER_RISK_TREND_PCT=0.25
RUNNER_RISK_SNAP_PCT=0.50
RUNNER_DAILY_LOSS_HALT_PCT=3
RUNNER_DRAWDOWN_HALT_PCT=25
# Optional: require this token (header X-Runner-Token) on POST /api/runner/control
RUNNER_CONTROL_TOKEN=
