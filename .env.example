# MASIS V3 — credentials and tuning. Copy to .env and fill in, or export directly.
#
# IMPORTANT: the previous version of server.py had live keys hard-coded as
# string literals in the source file. Treat every one of those keys as
# compromised and rotate it before using this system:
#   - Bybit:     API Management -> delete the old key, create a new one
#   - DeepSeek:  revoke the old API key and issue a new one
#   - Benzinga / CoinGecko: rotate likewise
# Never commit the filled-in .env.

# ── Required ──
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Demo endpoint by default. Point at https://api.bybit.com only when you
# intend to trade real money.
BYBIT_BASE_URL=https://api-demo.bybit.com

# ── Optional: supervisor model (the system runs fully without it) ──
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Hard daily ceiling on model calls. The old build had no ceiling and made
# roughly 2,400 calls a day, nearly all of them duplicates of a state that had
# not changed. 120 is generous for the gated policy in agents/deepseek-governor.js.
DEEPSEEK_DAILY_CALL_BUDGET=120

# ── Optional: news and macro context ──
BENZINGA_API_KEY=
COINGECKO_API_KEY=
NEWS_CACHE_TTL=300
MARKET_OVERVIEW_TTL=300
